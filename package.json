{
    "name": "platform-web-algotech",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:clean": "npm run clean && vite",
        "dev:force": "npm run clean && vite --force",
        "build": "tsc -b && vite build",
        "lint": "eslint . --ext .ts,.tsx,.js,.jsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" --ignore-path .gitignore",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" --ignore-path .gitignore",
        "type-check": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
        "test": "jest",
        "clean": "rm -rf dist node_modules/.vite"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "axios": "^1.15.0",
        "prettier": "^3.8.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-hook-form": "^7.56.1",
        "react-icons": "^5.5.0",
        "react-input-mask": "^2.0.4",
        "react-leaflet": "^5.0.0",
        "react-router-dom": "^7.5.3",
        "react-toastify": "^11.0.5",
        "tailwindcss": "^4.2.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@eslint/js": "^9.39.4",
        "@rolldown/plugin-babel": "^0.2.2",
        "@tailwindcss/vite": "^4.2.2",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "esbuild": "^0.28.0",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.58.0",
        "vite": "^8.0.4"
    }
}
